# --- Database ---
# For docker-compose postgres on localhost:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/meetmap?schema=public"

# --- Map styles (optional) ---
# Default is Positron; set your own MapLibre style if you want:
# NEXT_PUBLIC_MAP_STYLE="https://api.maptiler.com/maps/streets/style.json?key=${MAPTILER_KEY}"

# --- Geocoding (optional keys, will fall back to Nominatim) ---
MAPTILER_KEY=""
NEXT_PUBLIC_MAPTILER_KEY=""
OPENCAGE_KEY=""

# --- Next.js runtime hints (safe defaults) ---
# NODE_ENV is set by npm scripts, you usually don't need to set this.

