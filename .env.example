# Generate with: openssl rand -hex 24 (use URL-safe characters)
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
APP_URL=http://localhost:3000
PORT=3000
# Bind loopback by default; set 0.0.0.0 for LAN access behind your firewall.
BIND_ADDRESS=127.0.0.1
# Only used by native npm development, Compose supplies its own DATABASE_URL.
DATABASE_URL=postgresql://meetmap:replace-with-a-long-random-hex-password@localhost:5432/meetmap
UPLOAD_DIR=./data/uploads
# Optional local AI; no external AI calls are made.
OLLAMA_URL=http://localhost:11434
# Compose uses its own service address; change only for a separate Ollama host.
OLLAMA_DOCKER_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:4b
# Called server-side only after the owner enables online map services.
GEOCODER_URL=https://nominatim.openstreetmap.org
# Optional photo import from your own Immich server. The key stays server-side.
# Use the final server URL (with or without /api); redirects are rejected.
# Required API-key permissions: asset.read and asset.download.
IMMICH_URL=
IMMICH_API_KEY=
