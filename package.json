{
  "name": "meetmap",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && node scripts/sync-map-assets.mjs && next build",
    "start": "next start --hostname 0.0.0.0",
    "postinstall": "prisma generate && node scripts/sync-map-assets.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "test:serve": "node scripts/test-server.mjs",
    "test:integration": "node tests/integration/api.mjs && node tests/integration/uploads.mjs",
    "test:integration:travel": "node tests/integration/travel.mjs && node tests/integration/travel-photos.mjs && node tests/integration/anticipation.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/lora": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "6.19.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.90.0",
    "argon2": "^0.44.0",
    "exifr": "^7.1.3",
    "file-type": "^21.1.1",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "6.9.0",
    "next": "16.3.5",
    "prisma": "6.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.62.0",
    "sharp": "0.35.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "effect": "^3.20.0",
    "deepmerge-ts": "^8.0.0"
  }
}
